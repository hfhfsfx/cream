                    local MyAnim = AnimSaves:FindFirstChild(AnimName) or AnimSaves:FindFirstChild(AnimType .. "" .. AnimName)
                    --print("MY Anim", MyAnim and MyAnim.Name or "na", "//", MyAnim and MyAnim:GetFullName() or "na")
                    if MyAnim then
                        if AnimName:find("swing") then swing = swing == "swing2" and "swing1" or "swing2" end -- order h1-h2
                        tracks[AnimFullName] = tracks[AnimFullName] or MyAnimator:LoadAnimation(MyAnim)
                        if tracks[AnimFullName].IsPlaying then tracks[AnimFullName]:Stop(0.0) task.wait() end
                        tracks[AnimFullName].Priority = track.Priority
                        tracks[AnimFullName].Looped = track.Looped
                        tracks[AnimFullName]:Play(0.2)
                        task.spawn(function()
                            while track.IsPlaying do
                                task.wait(0.001)
                                local m = 1.0
                                m = AnimName == "Run" and 0.75 or m
                                m = AnimName == "slamkill" and 3 or m
                                tracks[AnimFullName]:AdjustSpeed(track.Speed * m)
                            end
                            if track.Looped then tracks[AnimFullName]:Stop(0.2) end
                        end)
                    end
                    break
                end
            end)
        end
    end
    SetupMyAnimator(Character.Name.."_ov1")
    if IsPlayer then SetupMyAnimator(Character.Name.."_ov2") end
    
    -- trigger AnimationPlayed to handle already played anims before my connection
    task.spawn(function()
        for _, track in ipairs(Character.Humanoid.Animator:GetPlayingAnimationTracks()) do
        	warn(hi, "Already played (restarting):", track.Name, track.Animation.AnimationId, track:Play(0))
        end
    end)

    print(hi, "Updating finished for", Character.Name .. "!")
end

