    local function addRing()
        if #ringParts == 0 then
            local raw = {}
            for _, v in ipairs(Character:FindFirstChild(Character.Name.."_ov1"):GetDescendants()) do
                if v.Name == "Object_8" and v:IsA("BasePart") then
                    local dup = false
                    for _, p in ipairs(raw) do if (p.Position - v.Position).Magnitude < 0.1 then dup = true; break end end
                    if not dup then table.insert(raw, v) end
                end
            end
            table.sort(raw, function(a, b) return a.Position.Y > b.Position.Y end)
            ringParts = raw
        end

        local part = ringParts[ringIdx]
        if not part then return end

        local ring = game:GetObjects("rbxassetid://126464609641022")[1]
        local primary = ring.PrimaryPart or ring:FindFirstChildWhichIsA("BasePart")
        
        for _, v in ipairs(ring:GetDescendants()) do 
            if v:IsA("BasePart") then v.Anchored = true; v.CanCollide = false end 
        end

        local hrp = Character:FindFirstChild("HumanoidRootPart") or Character:FindFirstChildWhichIsA("BasePart")
        local startCF = hrp.CFrame * CFrame.new(0, -1, -5)
        
        ring:PivotTo(startCF)
        ring.Parent = workspace

        local startTime = tick()
        local duration = 0.6
        local conn
        conn = game:GetService("RunService").RenderStepped:Connect(function()
            if not part.Parent or not ring.Parent then 
                if conn then conn:Disconnect() end 
                if ring.Parent then ring:Destroy() end
                return 
            end
            local alpha = math.min((tick() - startTime) / duration, 1)
            local eased = 1 - (1 - alpha)^5 
            local targetCF = part.CFrame * CFrame.Angles(0, math.rad(90), 0)
            ring:PivotTo(startCF:Lerp(targetCF, eased))
            if alpha >= 1 then
                conn:Disconnect()
                for _, v in ipairs(ring:GetDescendants()) do 
                    if v:IsA("BasePart") then v.Anchored = false end 
                end
                ring.Parent = part
                local w = Instance.new("Weld", part)
                w.Part0, w.Part1, w.C0 = part, primary, CFrame.Angles(0, math.rad(90), 0)
            end
        end)
        
        ringIdx += 1
    end

