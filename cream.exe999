   Callback = function(Value)
      teleporEnabled = Value
   end,
})

RunService.Heartbeat:Connect(function()
   if teleporEnabled then
      for i = 1, 10 do
         headRotation:FireServer(
            CFrame.new(999999, 999999, 999999, 1, 0, 0, 0, 1, 0, 0, 0, 1)
         )
      end
