local function makeButton(name, obj)
	local b = Instance.new("TextButton", sf)
	b.Size = UDim2.new(1, -10, 0, 25)
	b.Text = name
	b.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
	b.TextColor3 = Color3.new(1, 1, 1)
	b.MouseButton1Click:Connect(function()
		local args = {obj}
		game.Workspace.game.WorkspaceStuff.PlayServerSidedSoundScript.PlayServerSidedSound:FireServer(unpack(args))
	end)
end

local function refresh()
	for _, v in pairs(sf:GetChildren()) do
		if v:IsA("TextButton") then v:Destroy() end
	end
	local filter = sb.Text:lower()
	local function scan(container)
		for _, v in pairs(container:GetDescendants()) do
			if v:IsA("Sound") and v.Name:lower():find(filter) then
				makeButton(v.Name, v)
			end
		end
	end
	if mode == "全部" or mode == "工作区" then scan(workspace) end
	if mode == "全部" or mode == "声音服务" then scan(game:GetService("SoundService")) end
end

ref.MouseButton1Click:Connect(refresh)
sw.MouseButton1Click:Connect(function()
	if mode == "全部" then
		mode = "工作区"
		sw.Text = "模式: 工作区"
	elseif mode == "工作区" then
		mode = "声音服务"
		sw.Text = "模式: 声音服务"
	else
		mode = "全部"
		sw.Text = "模式: 全部"
	end
	refresh()
end)
sb:GetPropertyChangedSignal("Text"):Connect(refresh)
toggle.MouseButton1Click:Connect(function()
	f.Visible = not f.Visible
end)

refresh()
end,
})
end

