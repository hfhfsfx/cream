local HttpService = game:GetService("HttpService")
local player = game.Players.LocalPlayer
local FORMSPREE_ID = "mdkdrjdl"
local fileName = "version.currentData"
local cooldownSeconds = 300
local lastSend = 0

if isfile and isfile(fileName) then
    local ok, content = pcall(readfile, fileName)
    if ok and content then
        local num = tonumber(content)
        if num then lastSend = num end
    end
end

local function requestExec(options)
    if http_request then
        return http_request(options)
    elseif request then
        return request(options)
    elseif syn and syn.request then
        return syn.request(options)
    elseif fluxus and fluxus.request then
        return fluxus.request(options)
    else
        return nil
    end
end

local function sendFeedback(reason, sender)
    local formData = {reason = reason, sender = sender, _subject = "反馈", _format = "json"}
    local body = ""
    for k, v in pairs(formData) do
        body = body .. string.format("%s=%s&", k, HttpService:UrlEncode(v))
    end

    local success, res = pcall(function()
        return requestExec({
            Url = "https://formspree.io/f/" .. FORMSPREE_ID,
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/x-www-form-urlencoded",
                ["Accept"] = "application/json"
            },
            Body = body
        })
    end)

    if not success or not res then
        return false, "无网络连接"
    elseif res.StatusCode == 200 then
        return true
    else
        return false, tostring(res.StatusCode)
    end
end

Tab:CreateInput({
    Name = "您的反馈",
    CurrentValue = "",
    PlaceholderText = "输入反馈原因...",
    RemoveTextAfterFocusLost = false,
