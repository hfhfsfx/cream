        getgenv().feedbackEmail = Text
    end,
})

local FeedbackButton = Tab:CreateButton({
    Name = "发送",
    Callback = function()
        local now = os.time()
        if now - lastSend < cooldownSeconds then
            Rayfield:Notify({
                Title = "反馈",
                Content = "您发送得太快了。",
                Duration = 3
            })
            if FeedbackButton and type(FeedbackButton.Set) == "function" then pcall(function() FeedbackButton:Set("太快了") end) end
            task.wait(2)
            if FeedbackButton and type(FeedbackButton.Set) == "function" then pcall(function() FeedbackButton:Set("发送") end) end
            return
        end

        local reason = getgenv().feedbackReason or ""
        if reason == "" then
            Rayfield:Notify({
                Title = "反馈",
                Content = "请输入反馈原因。",
                Duration = 3
            })
            if FeedbackButton and type(FeedbackButton.Set) == "function" then pcall(function() FeedbackButton:Set("无输入") end) end
            task.wait(2)
            if FeedbackButton and type(FeedbackButton.Set) == "function" then pcall(function() FeedbackButton:Set("发送") end) end
            return
        end

        local email = getgenv().feedbackEmail or ""
        local pattern = "^[A-Za-z0-9._%%+%-]+@[A-Za-z0-9%-]+%.[A-Za-z][A-Za-z]+$"
        if email ~= "" and not email:match(pattern) then
            Rayfield:Notify({
                Title = "反馈",
                Content = "无效的邮箱。请修正或留空。",
                Duration = 3
            })
            if FeedbackButton and type(FeedbackButton.Set) == "function" then pcall(function() FeedbackButton:Set("无效邮箱") end) end
            task.wait(2)
            if FeedbackButton and type(FeedbackButton.Set) == "function" then pcall(function() FeedbackButton:Set("发送") end) end
            return
        end

        local sender = (email ~= "" and email:match(pattern)) and (email .. " (" .. player.Name .. ")") or player.Name

        local ok, code = sendFeedback(reason, sender)
        if ok then
            Rayfield:Notify({
                Title = "反馈",
                Content = "反馈发送成功！",
                Duration = 3
            })
            if FeedbackButton and type(FeedbackButton.Set) == "function" then pcall(function() FeedbackButton:Set("反馈已发送！") end) end
            lastSend = now
            if writefile then pcall(function() writefile(fileName, tostring(now)) end) end
        else
            local msg = "发送反馈失败。请稍后重试。"
            if code == "no_network" then
                msg = "未检测到网络连接。"
            elseif tonumber(code) then
                msg = "服务器返回错误: " .. code
            end

            Rayfield:Notify({
                Title = "反馈",
                Content = msg,
                Duration = 3
            })
            if FeedbackButton and type(FeedbackButton.Set) == "function" then pcall(function() FeedbackButton:Set("发送失败") end) end
        end

        task.wait(2)
        if FeedbackButton and type(FeedbackButton.Set) == "function" then pcall(function() FeedbackButton:Set("发送") end) end
    end,
})

if FeedbackButton and type(FeedbackButton.Set) == "function" then pcall(function() FeedbackButton:Set("发送") end) end

