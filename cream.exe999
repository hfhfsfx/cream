})

local function findPartInCharacter(character, name)
    if not character then return nil end
    local exact = character:FindFirstChild(name)
    if exact then return exact end
    local lname = name:lower()
    for _, obj in ipairs(character:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name:lower() == lname then
            return obj
        end
    end
    return nil
end

Tab:CreateButton({
    Name = "销毁",
    Callback = function()
        local selectedPlayer = Dropdown.CurrentOption and Dropdown.CurrentOption[1]
        local selectedParts = PartDropdown.CurrentOption or {}
        if not selectedPlayer or #selectedParts == 0 then
            warn("请选择一个玩家和至少一个部位！")
            return
        end

        local targetPlayers = {}
        if selectedPlayer == "所有人" then
            for _, p in ipairs(Players:GetPlayers()) do
                table.insert(targetPlayers, p)
            end
        elseif selectedPlayer == "所有人（除了我）" then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer then
                    table.insert(targetPlayers, p)
                end
            end
        else
            local p = Players:FindFirstChild(selectedPlayer)
            if p then
                table.insert(targetPlayers, p)
            else
                warn("玩家 \""..tostring(selectedPlayer).."\" 未在玩家列表中找到。")
                return
            end
        end

        for _, player in ipairs(targetPlayers) do
            if player and player.Character then
                for _, partName in ipairs(selectedParts) do
                    local part = findPartInCharacter(player.Character, partName)
                    if part then
                        print("workspace."..player.Name.."."..part.Name)
                        destroyObject(part)
                    else
                        warn(partName.." 在 "..player.Name.." 的角色中未找到")
                    end
                end
            else
                warn("玩家 "..(player and player.Name or "未知").." 的角色未找到")
            end
        end
    end,
})

