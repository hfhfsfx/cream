            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character then
                    pcall(function()
                       destroyObject(player)
                    end)
                end
            end
        else
            local player = Players:FindFirstChild(current)
            if player and player.Character then
                pcall(function()
                   destroyObject(player)
                end)
            end
        end
    end,
})

