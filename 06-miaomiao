local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer

local CHECK_INTERVAL = 0.1
local FIRE_INTERVAL = 0.01
local GEN_RANGE = 50
local LOCKER_RANGE = 30
local LOCKER_INTERVAL = 0.5
local LOCKER_RESCAN_INTERVAL = 3

local CAR_ACTION_INTERVAL = 0.1 -- 自动加油/修车间隔

local chunksFolder = Workspace:WaitForChild("game"):WaitForChild("map"):WaitForChild("chunks")

local Event = ReplicatedStorage.remotes.actions
local ItemEvent = ReplicatedStorage.remotes.itemActions

local function isTargetChunk(chunk)
	local num = tonumber(string.match(chunk.Name, "^chunk(%d+)$"))
	return num ~= nil and num >= 1 and num <= 41
end

-- ===== 清理 clingTriggers =====
local function clearClingTriggers()
	for _, chunk in ipairs(chunksFolder:GetChildren()) do
		if not isTargetChunk(chunk) then continue end
		local clingTriggers = chunk:FindFirstChild("clingTriggers")
		if clingTriggers then
			for _, child in ipairs(clingTriggers:GetChildren()) do
				child:Destroy()
			end
		end
	end
end

task.spawn(function()
	while true do
		clearClingTriggers()
		task.wait(CHECK_INTERVAL)
	end
end)

local function getAllGenerators()
	local allGens = {}
	for _, chunk in ipairs(chunksFolder:GetChildren()) do
		if not isTargetChunk(chunk) then continue end
		for _, descendant in ipairs(chunk:GetDescendants()) do
			if descendant.Name == "generators" and descendant:IsA("Folder") then
				for _, gen in ipairs(descendant:GetChildren()) do
					if gen:IsA("BasePart") or gen:IsA("Model") then
						table.insert(allGens, gen)
					end
				end
			end
		end
	end
	return allGens
end

local closestGen = nil

task.spawn(function()
	while true do
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if not root then
			closestGen = nil
			task.wait(CHECK_INTERVAL)
			continue
		end

		local allGens = getAllGenerators()
		local closest = nil
		local minDist = math.huge

		for _, gen in ipairs(allGens) do
			local genPos
			if gen:IsA("Model") and gen.PrimaryPart then
				genPos = gen.PrimaryPart.Position
			elseif gen:IsA("BasePart") then
				genPos = gen.Position
			else
				continue
			end

			local dist = (root.Position - genPos).Magnitude
			if dist < minDist then
				minDist = dist
				closest = gen
			end
		end

		if closest and minDist <= GEN_RANGE then
			closestGen = closest
		else
			closestGen = nil
		end

		task.wait(CHECK_INTERVAL)
	end
end)

task.spawn(function()
	while true do
		if closestGen then
			Event:FireServer("repairGenerator", closestGen)
		end
		task.wait(FIRE_INTERVAL)
	end
end)

local function getPos(obj)
	if obj:IsA("Model") then
		if obj.PrimaryPart then
			return obj.PrimaryPart.Position
		end
		local part = obj:FindFirstChildWhichIsA("BasePart")
		if part then return part.Position end
		return nil
	elseif obj:IsA("BasePart") then
		return obj.Position
	end
	return nil
end

local lockerCache = {}

local function getRangeFor(name)
	if name == "locked_chest" then return 25 end
	if name == "locked_carProp" then return 25 end
	if name == "locked_medicLocker" then return 25 end
	if name == "safeVault" then return 25 end
	return LOCKER_RANGE
end

-- 需要自动开锁的目标名称
local LOCKED_NAMES = {
	["locked_locker"] = true,
	["locked_gunLocker"] = true,
	["locked_chest"] = true,
	["locked_medicLocker"] = true,
	["safeVault"] = true,
}

local function rescanLockers()
	local cache = {}

	for _, chunk in ipairs(chunksFolder:GetChildren()) do
		if not isTargetChunk(chunk) then continue end

		local structures = chunk:FindFirstChild("structures")
		if structures then
			for _, structChild in ipairs(structures:GetChildren()) do
				for _, folderName in ipairs({ "lockers", "gunLockers", "chests", "medicLockers", "safeVaults" }) do
					local folder = structChild:FindFirstChild(folderName)
					if folder then
						for _, locker in ipairs(folder:GetDescendants()) do
							if LOCKED_NAMES[locker.Name] then
								local pos = getPos(locker)
								if pos then
									table.insert(cache, {
										obj = locker,
										pos = pos,
										range = getRangeFor(locker.Name)
									})
								end
							end
						end
					end
				end
			end
		end

		local customFloor = chunk:FindFirstChild("customFloor")
		if customFloor then
			local hardCodedTerrain = customFloor:FindFirstChild("hardCodedTerrain")
			if hardCodedTerrain then
				local cars = hardCodedTerrain:FindFirstChild("cars")
				if cars then
					for _, carProp in ipairs(cars:GetChildren()) do
						if carProp.Name == "locked_carProp" then
							local pos = getPos(carProp)
							if pos then
								table.insert(cache, {
									obj = carProp,
									pos = pos,
									range = getRangeFor(carProp.Name)
								})
							end
						end
					end
				end
			end
		end
	end

	lockerCache = cache
end

task.spawn(function()
	while true do
		local ok, err = pcall(rescanLockers)
		if not ok then
			warn("[AutoLocker] rescan failed:", err)
		end
		task.wait(LOCKER_RESCAN_INTERVAL)
	end
end)

local nearbyLocked = {}

task.spawn(function()
	while true do
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")

		if not root then
			nearbyLocked = {}
			task.wait(CHECK_INTERVAL)
			continue
		end

		local rootPos = root.Position
		local found = {}

		for _, entry in ipairs(lockerCache) do
			if entry.obj and entry.obj.Parent then
				local dist = (rootPos - entry.pos).Magnitude
				if dist <= (entry.range or LOCKER_RANGE) then
					table.insert(found, entry.obj)
				end
			end
		end

		nearbyLocked = found
		task.wait(CHECK_INTERVAL)
	end
end)

task.spawn(function()
	while true do
		for _, locker in ipairs(nearbyLocked) do
			pcall(function()
				Event:FireServer("openInteractable", locker)
			end)
		end
		task.wait(LOCKER_INTERVAL)
	end
end)

local toolCache = {}
local lastDrinkTrigger = false

-- 自动加油/修车的节流计时
local lastGasTime = 0
local lastRepairTime = 0

local function updateCache()
	local character = player.Character
	if not character then return end

	toolCache = {}

	for _, obj in ipairs(character:GetChildren()) do
		if obj.ClassName == "Tool" then
			local handle = obj:FindFirstChild("Handle")
			if handle then
				for _, sound in ipairs(handle:GetChildren()) do
					if sound.ClassName == "Sound" then
						local toolName = obj.Name
						local capitalized = string.upper(string.sub(toolName, 1, 1)) .. string.sub(toolName, 2)
						local remoteName = "use" .. capitalized

						table.insert(toolCache, {
							tool = obj,
							sound = sound,
							remoteName = remoteName
						})
						break
					end
				end
			end
		end
	end
end

local function checkAnimationPlaying(animId)
	local character = player.Character
	if not character then return false end

	local humanoid = character:FindFirstChildWhichIsA("Humanoid")
	if not humanoid then return false end

	local animator = humanoid:FindFirstChildWhichIsA("Animator")
	if not animator then return false end

	local animationTracks = animator:GetPlayingAnimationTracks()
	for _, track in ipairs(animationTracks) do
		if track.Animation then
			local animId2 = track.Animation.AnimationId
			if animId2 and string.find(animId2, animId) then
				return true
			end
		end
	end

	return false
end

RunService.Heartbeat:Connect(function()
	updateCache()

	local now = os.clock()
	local shouldTrigger = false

	local character = player.Character
	if character then
		local gasCan = character:FindFirstChild("gasCan")
		if gasCan then
			local handle = gasCan:FindFirstChild("Handle")
			if handle then
				local pour = handle:FindFirstChild("pour")
				if pour and pour.ClassName == "Sound" and pour.Playing == true then
					if now - lastGasTime >= CAR_ACTION_INTERVAL then
						lastGasTime = now
						local args = {
							"refillGas",
							workspace:WaitForChild("vehicles"):WaitForChild("defaultCar")
						}
						ReplicatedStorage:WaitForChild("remotes"):WaitForChild("actions"):FireServer(unpack(args))
					end
				end
			end
		end
	end

	local defaultCar = workspace:FindFirstChild("vehicles")
	if defaultCar then
		defaultCar = defaultCar:FindFirstChild("defaultCar")
		if defaultCar then
			local stats = defaultCar:FindFirstChild("stats")
			if stats then
				local durability = stats:FindFirstChild("durability")
				if durability and durability.Value < 100 then
					if character and character:FindFirstChild("wrench") then
						if now - lastRepairTime >= CAR_ACTION_INTERVAL then
							lastRepairTime = now
							local args = {
								"repairCar",
								workspace:WaitForChild("vehicles"):WaitForChild("defaultCar")
							}
							ReplicatedStorage:WaitForChild("remotes"):WaitForChild("itemActions"):FireServer(unpack(args))
						end
					end
				end
			end
		end
	end

	if checkAnimationPlaying("109210042273617") then
		if not lastDrinkTrigger then
			ItemEvent:FireServer("useDrink")
			lastDrinkTrigger = true
		end
		shouldTrigger = true
	else
		lastDrinkTrigger = false
	end

	local animationPlaying = checkAnimationPlaying("103647360619875") or checkAnimationPlaying("114181861515592")

	if animationPlaying then
		for _, data in ipairs(toolCache) do
			ItemEvent:FireServer(data.remoteName)
			break
		end
		shouldTrigger = true
	end

	if not shouldTrigger then
		for _, data in ipairs(toolCache) do
			if data.sound.Playing == true then
				ItemEvent:FireServer(data.remoteName)
				shouldTrigger = true
				break
			end
		end
	end

	if shouldTrigger and not checkAnimationPlaying("109210042273617") then
		ItemEvent:FireServer("useDrink")
	end
end)
