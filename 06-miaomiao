local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer

local CHECK_INTERVAL = 0.1
local FIRE_INTERVAL = 0.01
local GEN_RANGE = 50

local chunksFolder = Workspace:WaitForChild("game"):WaitForChild("map"):WaitForChild("chunks")

local Event = ReplicatedStorage.remotes.actions

local function isTargetChunk(chunk)
	local num = tonumber(string.match(chunk.Name, "^chunk(%d+)$"))
	return num ~= nil and num >= 1 and num <= 41
end

local function clearClingTriggers()
	for _, chunk in ipairs(chunksFolder:GetChildren()) do
		if not isTargetChunk(chunk) then continue end
		local clingTriggers = chunk:FindFirstChild("clingTriggers")
		if clingTriggers then
			for _, child in ipairs(clingTriggers:GetChildren()) do
				child:Destroy()
			end
		end
	end
end

task.spawn(function()
	while true do
		clearClingTriggers()
		task.wait(CHECK_INTERVAL)
	end
end)

local function getAllGenerators()
	local allGens = {}
	for _, chunk in ipairs(chunksFolder:GetChildren()) do
		if not isTargetChunk(chunk) then continue end
		for _, descendant in ipairs(chunk:GetDescendants()) do
			if descendant.Name == "generators" and descendant:IsA("Folder") then
				for _, gen in ipairs(descendant:GetChildren()) do
					if gen:IsA("BasePart") or gen:IsA("Model") then
						table.insert(allGens, gen)
					end
				end
			end
		end
	end
	return allGens
end

local closestGen = nil

task.spawn(function()
	while true do
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if not root then
			closestGen = nil
			task.wait(CHECK_INTERVAL)
			continue
		end

		local allGens = getAllGenerators()
		local closest = nil
		local minDist = math.huge

		for _, gen in ipairs(allGens) do
			local genPos
			if gen:IsA("Model") and gen.PrimaryPart then
				genPos = gen.PrimaryPart.Position
			elseif gen:IsA("BasePart") then
				genPos = gen.Position
			else
				continue
			end

			local dist = (root.Position - genPos).Magnitude
			if dist < minDist then
				minDist = dist
				closest = gen
			end
		end

		if closest and minDist <= GEN_RANGE then
			closestGen = closest
		else
			closestGen = nil
		end

		task.wait(CHECK_INTERVAL)
	end
end)

task.spawn(function()
	while true do
		if closestGen then
			Event:FireServer("repairGenerator", closestGen)
		end
		task.wait(FIRE_INTERVAL)
	end
end)
