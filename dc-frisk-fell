function refreshPlayerButtons()
    local localPlayer = Players.LocalPlayer
    for _, btn in pairs(playerButtons) do
        btn:Destroy()
    end
    playerButtons = {}
    
    local sx, sy = scaleFactorX, scaleFactorY
    local playerCount = 0
    local buttonWidth = math.floor(260 * sx - 20 * sx - 4 * sx - 10 * sy)
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player == localPlayer then continue end
        if not player.Character then continue end
        
        local isSelected = selectedPlayer == player
        local btn = Instance.new("TextButton")
        btn.Name = player.Name
        btn.Text = player.Name
        btn.Size = UDim2.new(0, buttonWidth, 0, math.floor(40 * sy))
        btn.Position = UDim2.new(0, math.floor(5 * sy), 0, playerCount * math.floor(45 * sy))
        btn.BackgroundColor3 = isSelected and Color3.fromRGB(0, 200, 100) or Color3.fromRGB(60, 60, 60)
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.Font = Enum.Font.Gotham
        btn.TextSize = math.max(1, math.floor(14 * math.min(sx, sy)))
        btn.BorderSizePixel = 0
        btn.AutoButtonColor = true
        btn.ZIndex = 99999999999999
        btn.Parent = ScrollingFrame
        
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, math.floor(4 * math.min(sx, sy)))
        corner.Parent = btn
        
        btn.MouseButton1Click:Connect(function()
            if selectedPlayer == player then
                selectedPlayer = nil
                btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
            else
                for _, b in pairs(playerButtons) do
                    b.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
                end
                selectedPlayer = player
                btn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
            end
            updateDropdownText()
        end)
        
        table.insert(playerButtons, btn)
        playerCount = playerCount + 1
    end
    
    ScrollingFrame.CanvasSize = UDim2.new(0, 0, 0, math.max(playerCount * math.floor(45 * sy), 0))
    updateDropdownText()
end

