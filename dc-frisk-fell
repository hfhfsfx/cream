    ScrollingFrame.Position = UDim2.new(0, math.floor(2 * sx), 0, math.floor(2 * sy))
    ScrollingFrame.ScrollBarThickness = math.floor(6 * minS)
    
    ControlFrame.Size = UDim2.new(1, -math.floor(20 * sx), 0, math.floor(40 * sy))
    if isListOpen then
        ControlFrame.Position = UDim2.new(0, math.floor(10 * sx), 0, math.floor((92 + LIST_HEIGHT + 8) * sy))
    else
        ControlFrame.Position = UDim2.new(0, math.floor(10 * sx), 0, math.floor(92 * sy))
    end
    
    AutoPullButton.Size = UDim2.new(1, 0, 0, math.floor(35 * sy))
    AutoPullButton.TextSize = math.max(1, math.floor(13 * minS))
    AutoPullButtonCorner.CornerRadius = UDim.new(0, math.floor(4 * minS))
    
    local targetHeight
    if isMinimized then
        targetHeight = 40
    elseif isListOpen then
        targetHeight = 92 + LIST_HEIGHT + 40 + 10
    else
        targetHeight = 92 + 40 + 10
    end
    MainFrame.Size = UDim2.new(0, math.floor(baseWidth * sx), 0, math.floor(targetHeight * sy))
    
    task.wait()
    updateResizeButtonPosition()
    if isListOpen and not isMinimized then
        refreshPlayerButtons()
    end
end

local function getCurrentPanelHeight()
    if isMinimized then
        return 40
    elseif isListOpen then
        return 92 + LIST_HEIGHT + 40 + 10
    else
        return 92 + 40 + 10
    end
end

local function animateWithResizeUpdate(animations, duration)
    local startTime = tick()
    for _, anim in pairs(animations) do
        anim:Play()
    end
    while tick() - startTime < duration do
        updateResizeButtonPosition()
        RunService.Heartbeat:Wait()
    end
    updateResizeButtonPosition()
end

local function toggleMainGui()
    if hasMoved then hasMoved = false; return end
    isGuiVisible = not isGuiVisible
    MainFrame.Visible = isGuiVisible
    updateResizeButtonVisibility()
    ToggleGuiButton.Text = isGuiVisible and "-" or "+"
    if isGuiVisible then
        task.wait()
        refreshPlayerButtons()
    end
end

local function togglePlayerList()
    if isAnimating then return end
    isAnimating = true
    isListOpen = not isListOpen
    
    local tweenInfo = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local sx = scaleFactorX
    local sy = scaleFactorY
    
    if isListOpen then
        refreshPlayerButtons()
        PlayerListContainer.Size = UDim2.new(1, -math.floor(20 * sx), 0, 0)
        PlayerListContainer.BackgroundTransparency = 1
        PlayerListContainer.Visible = true
        updateResizeButtonVisibility()
        
        local t1 = TweenService:Create(ControlFrame, tweenInfo, {
            Position = UDim2.new(0, math.floor(10 * sx), 0, math.floor((92 + LIST_HEIGHT + 8) * sy))
        })
        local t2 = TweenService:Create(PlayerListContainer, tweenInfo, {
            Size = UDim2.new(1, -math.floor(20 * sx), 0, math.floor(LIST_HEIGHT * sy)),
            BackgroundTransparency = 0
        })
        local t3 = TweenService:Create(MainFrame, tweenInfo, {
            Size = UDim2.new(0, math.floor(260 * sx), 0, math.floor((92 + LIST_HEIGHT + 40 + 10) * sy))
        })
        
        animateWithResizeUpdate({t1, t2, t3}, 0.25)
        isAnimating = false
        updateResizeButtonPosition()
        updateDropdownText()
    else
        local t1 = TweenService:Create(ControlFrame, tweenInfo, {
            Position = UDim2.new(0, math.floor(10 * sx), 0, math.floor(92 * sy))
        })
        local t2 = TweenService:Create(PlayerListContainer, tweenInfo, {
            Size = UDim2.new(1, -math.floor(20 * sx), 0, 0),
            BackgroundTransparency = 1
        })
        local t3 = TweenService:Create(MainFrame, tweenInfo, {
            Size = UDim2.new(0, math.floor(260 * sx), 0, math.floor((92 + 40 + 10) * sy))
        })
        
        animateWithResizeUpdate({t1, t2, t3}, 0.25)
        PlayerListContainer.Visible = false
        updateResizeButtonVisibility()
        isAnimating = false
        updateDropdownText()
    end
end

local function createDragBar(name, position, size)
    local bar = Instance.new("Frame")
    bar.Name = name
    bar.Size = size
    bar.Position = position
    bar.BackgroundTransparency = 1
    bar.ZIndex = 99999999999999
    bar.Parent = MainFrame

    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isPanelDragging = true
            panelDragStart = input.Position
            panelStartPos = MainFrame.Position
            panelDragInput = input
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    isPanelDragging = false
                    panelDragInput = nil
                end
            end)
        end
    end)
    bar.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            panelDragInput = input
        end
    end)
end

