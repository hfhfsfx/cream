        dragStart = input.Position; startPos = ToggleGuiButton.Position; dragInput = input
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false; dragInput = nil end
        end)
    end
end)

ToggleGuiButton.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

TitleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isPanelDragging = true
        panelDragStart = input.Position; panelStartPos = MainFrame.Position; panelDragInput = input
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then isPanelDragging = false; panelDragInput = nil end
        end)
    end
end)

TitleBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        panelDragInput = input
    end
end)

local function updateButton(input)
    local delta = input.Position - dragStart
    ToggleGuiButton.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    if math.abs(delta.X) > 5 or math.abs(delta.Y) > 5 then hasMoved = true end
end

local function updatePanel(input)
    local delta = input.Position - panelDragStart
    MainFrame.Position = UDim2.new(panelStartPos.X.Scale, panelStartPos.X.Offset + delta.X, panelStartPos.Y.Scale, panelStartPos.Y.Offset + delta.Y)
    updateResizeButtonPosition()
end

local function updateResize(input)
    local delta = input.Position - resizeStartPos
    local currentHeight = getCurrentPanelHeight()
    local newWidth = resizeStartSize.X + delta.X
    local newHeight = resizeStartSize.Y + delta.Y
    
    local minScale = 0.1
    local maxScale = 5.0
    
    scaleFactorX = math.clamp(newWidth / baseWidth, minScale, maxScale)
    scaleFactorY = math.clamp(newHeight / currentHeight, minScale, maxScale)
    updateAllElementSizes()
end

UserInputService.InputChanged:Connect(function(input)
    if isResizing and input == resizeDragInput then
        updateResize(input)
    elseif dragging and input == dragInput then
        updateButton(input)
    elseif isPanelDragging and input == panelDragInput then
        updatePanel(input)
    end
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not isAutoPullActive then return end
    if gameProcessed then return end
    if input.UserInputType == Enum.UserInputType.Touch then
        touchStartPos = input.Position
    elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
        if selectedPlayer then
            pullPlayer(selectedPlayer)
        end
    end
end)

UserInputService.InputEnded:Connect(function(input, gameProcessed)
    if not isAutoPullActive then return end
    if input.UserInputType == Enum.UserInputType.Touch and touchStartPos then
        local delta = (input.Position - touchStartPos).Magnitude
        if delta < 10 then
            if selectedPlayer then
                pullPlayer(selectedPlayer)
            end
        end
        touchStartPos = nil
    end
end)

local function cleanup()
    for _, btn in pairs(playerButtons) do
        btn:Destroy()
    end
    playerButtons = {}
    ScreenGui:Destroy()
end

Players.LocalPlayer.CharacterAdded:Connect(function()
    cleanup()
end)

refreshPlayerButtons()
updateResizeButtonVisibility()
