-- 格挡exe阵营攻击（单Block限制+0.2秒冷却+换号适配）
local isBlockActive = false
local checkLoop = nil
local lastExecuteTime = 0
local COOLDOWN = 1 -- 冷却时间
local MAX_BLOCK_COUNT = 1 -- 最大Block数量

-- 生存/自杀标签页-自保板块添加开关
SurvivalTab:CreateToggle({
    Name = "『开启/关闭格挡exe阵营所有攻击(除了chara的远程)』",
    CurrentValue = false,
    Flag = "BlockExeAttackToggle",
    Callback = function(isOn)
        isBlockActive = isOn
        if isOn then
            -- 开启时启动检测循环
            checkLoop = game:GetService("RunService").RenderStepped:Connect(function()
                local localPlayer = game:GetService("Players").LocalPlayer
                local character = localPlayer.Character
                if not character then return end -- 角色未加载则跳过
                
                -- 统计当前Block数量
                local blockCount = #character:GetChildren()
                local actualBlockCount = 0
                for _, child in ipairs(character:GetChildren()) do
                    if child.Name == "Block" then
                        actualBlockCount += 1
                    end
                end
                
                -- 满足条件（无Block/Block数量<1、冷却结束）则执行格挡
                local currentTime = os.clock()
                if actualBlockCount < MAX_BLOCK_COUNT and currentTime - lastExecuteTime >= COOLDOWN then
                    local args = {character, true}
                    local success = pcall(function()
                        game:GetService("ReplicatedStorage")
                            :WaitForChild("PlayerRemoteEvents")
                            :WaitForChild("BlockEvent")
                            :FireServer(unpack(args))
                    end)
                    if success then
                        lastExecuteTime = currentTime -- 更新冷却时间
                        print("[格挡功能] 触发格挡，当前Block数量：" .. actualBlockCount)
                    end
                end
            end)
            print("[格挡功能] 已开启（单Block限制+0.2秒冷却）")
        else
            -- 关闭时停止循环
            if checkLoop then
                checkLoop:Disconnect()
                checkLoop = nil
            end
            print("[格挡功能] 已关闭")
        end
    end
})
-- ==================== 无限抵挡普通攻击（优化检测版） ====================
local isShutdownLoopRunning = false
local LocalPlayer = game.Players.LocalPlayer
local function getCurrentPlayerCharacter()
    return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

SurvivalTab:CreateToggle({
    Name = "『开启/关闭抵挡exe阵营普通攻击(技能不能抵挡)』",
    CurrentValue = false,
    Flag = "InfiniteBlockToggle",
    Callback = function(Value)
        if Value then
            getgenv().farm = true
            task.spawn(function()
                while getgenv().farm do
                    local playerChar = getCurrentPlayerCharacter()
                    -- 检测不到Counter时才触发true
                    if playerChar and not playerChar:FindFirstChild("Counter") then
                        game.ReplicatedStorage.PlayerRemoteEvents.Vanilla.Counter:FireServer(true, 100)
                    end
                    task.wait()
                end
            end)
            print("[维度融合] 无限抵挡普通攻击已开启（仅无Counter时触发）")
        else
            getgenv().farm = false
            if not isShutdownLoopRunning then
                isShutdownLoopRunning = true
                task.spawn(function()
                    while true do
                        local playerChar = getCurrentPlayerCharacter()
                        -- 检测到Counter时执行false，消失则停止循环
                        if playerChar and playerChar:FindFirstChild("Counter") then
                            game.ReplicatedStorage.PlayerRemoteEvents.Vanilla.Counter:FireServer(false, 100)
                        else
                            isShutdownLoopRunning = false
                            break
                        end
                        task.wait()
                    end
                end)
            end
            print("[维度融合] 无限抵挡普通攻击已关闭（仅存在Counter时执行false）")
        end
    end
})


