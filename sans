        if targetJumpBoostLoop then task.cancel(targetJumpBoostLoop) end
        if targetSayoriHealLoop then task.cancel(targetSayoriHealLoop) end

        -- 销毁 Rayfield 窗口
        Rayfield:Destroy()
    end
})
