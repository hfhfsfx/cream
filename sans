-- ==================== 动态倒地自救（适配换号，自动匹配当前角色） ====================
local isDynamicSelfRescueActive = false
local downedWatchConnection = nil
local characterCheckConnection = nil

-- 核心监听函数：动态绑定当前角色
local function bindToCurrentCharacter()
    local Players = game:GetService("Players")
    local LocalPlayer = Players.LocalPlayer
    local targetCharacter = LocalPlayer.Character -- 动态获取本地玩家角色（角色名与用户名一致）
    
    -- 若角色未加载，等待加载后绑定
    if not targetCharacter then
        targetCharacter = LocalPlayer.CharacterAdded:Wait()
        print("[维度融合] 本地角色加载完成，开始监听倒地状态")
    end

    -- 立即检测是否已倒地
    if targetCharacter:FindFirstChild("Downed") then
        game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Character"):WaitForChild("reviveEvent"):FireServer(LocalPlayer)
        print("[维度融合] 检测到当前角色已倒地，触发即时自救")
    end

    -- 监听角色下Downed对象创建
    downedWatchConnection = targetCharacter.ChildAdded:Connect(function(child)
        if child.Name == "Downed" then
            game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Character"):WaitForChild("reviveEvent"):FireServer(LocalPlayer)
            print("[维度融合] 检测到当前角色创建Downed，触发自救复活")
        end
    end)
end

