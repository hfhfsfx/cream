                            :WaitForChild("inSelection", 5)
                            :WaitForChild("characterSelectionControlEvent", 5)
                            :FireServer(unpack(args))
                    end)
                    if success then
                        print("[维度融合] 延迟8秒执行成功，切换至角色：" .. autoSelectChar)
                    else
                        warn("[维度融合] 延迟切换失败：" .. err)
