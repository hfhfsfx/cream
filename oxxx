local replicatedStorage = game:GetService("ReplicatedStorage")
local player = game:GetService("Players").LocalPlayer

local playersConfig = replicatedStorage:FindFirstChild("playersConfig")
if playersConfig then
    local targetPlayer = playersConfig:FindFirstChild(player.Name)
    if targetPlayer then
        local pvFolder = targetPlayer:FindFirstChild("pv")
        if pvFolder then
            local exeValue = pvFolder:FindFirstChild("exe")
            if exeValue and exeValue:IsA("BoolValue") then
                exeValue.Value = true
            end
        end
    end
end
