task.spawn(function()
	while true do
		local projectileFolder = workspace:FindFirstChild("Projectile")
		if projectileFolder then
			local chasetrapObj = projectileFolder:FindFirstChild("chasetrap")
			if chasetrapObj then
				setupChasetrap(chasetrapObj)
				for _, child in pairs(chasetrapObj:GetChildren()) do
					setupChasetrap(child)
				end
			end
			
			local trapsFolder = projectileFolder:FindFirstChild("Traps")
			if trapsFolder then
				local currentMines = {}
				for _, child in pairs(trapsFolder:GetChildren()) do
					if child:IsA("UnionOperation") and child.Name == "Union" then
						setupMine(child)
						currentMines[child] = true
					end
				end
				
				for mine in pairs(trackedMines) do
					if not currentMines[mine] or not mine.Parent then
						cleanupMine(mine)
					end
				end
			end
		end
		task.wait(0.1)
	end
end)

