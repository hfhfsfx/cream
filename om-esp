	local billboard = Instance.new("BillboardGui")
	billboard.Name = "MineLabel"
	billboard.Adornee = union
	billboard.Size = UDim2.new(0, 50 * fontSizeMultiplier, 0, 19 * fontSizeMultiplier)
	billboard.AlwaysOnTop = true
	billboard.StudsOffset = Vector3.new(0, 2, 0)
	
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.TextColor3 = Color3.fromRGB(0, 100, 0)
	label.Text = "MINE"
	label.TextScaled = true
	label.Font = Enum.Font.SourceSansBold
	label.TextStrokeTransparency = 0.5
	label.Parent = billboard
	billboard.Parent = union
	
	trackedMines[union] = {part = union, position = union.Position}
end

local function cleanupMine(union)
	local data = trackedMines[union]
	if data then
		local part = Instance.new("Part")
		part.Size = Vector3.new(2, 2, 2)
		part.Position = data.position
		part.Anchored = true
		part.CanCollide = false
		part.Transparency = 1
		part.Parent = workspace
		
		local billboard = Instance.new("BillboardGui")
		billboard.Name = "ExplodedLabel"
		billboard.Adornee = part
		billboard.Size = UDim2.new(0, 90 * fontSizeMultiplier, 0, 19 * fontSizeMultiplier)
		billboard.AlwaysOnTop = true
		billboard.StudsOffset = Vector3.new(0, 2, 0)
		
		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(1, 0, 1, 0)
		label.BackgroundTransparency = 1
		label.TextColor3 = Color3.fromRGB(0, 100, 0)
		label.Text = "EXPLODED"
		label.TextScaled = true
		label.Font = Enum.Font.SourceSansBold
		label.TextStrokeTransparency = 0.5
		label.Parent = billboard
		billboard.Parent = part
		
		task.delay(1, function()
			if part and part.Parent then part:Destroy() end
		end)
		
		trackedMines[union] = nil
	end
end

local function setupChasetrap(trap)
	if not trap:FindFirstChild("ChasetrapHighlight") then
		local highlight = Instance.new("Highlight")
		highlight.Name = "ChasetrapHighlight"
		highlight.FillColor = Color3.fromRGB(0, 100, 0)
		highlight.OutlineColor = Color3.fromRGB(0, 100, 0)
		highlight.FillTransparency = 0.7
		highlight.OutlineTransparency = 0.4
		highlight.Parent = trap
	end
end

