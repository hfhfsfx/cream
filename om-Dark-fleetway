local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
 
local function _O(t)
    local s = ""
    for _, v in ipairs(t) do
        s = s .. string.char(v / 2 - 5)
    end
    return s
end
 
local NEW_LAUGH_ID = _O({238, 206, 250, 204, 240, 240, 212, 242, 220, 210, 126, 104, 104, 108, 106, 118, 118, 110, 110, 114, 112, 110, 122, 118, 118, 110, 108, 106})
local MODEL_ID = _O({238, 206, 250, 204, 240, 240, 212, 242, 220, 210, 126, 104, 104, 120, 114, 122, 112, 110, 108, 112, 106, 106, 110, 110, 108, 116, 106})
local loadedModel = nil
 
task.spawn(function()
    while task.wait(1) do
        local clientAssets = game:GetService("ReplicatedStorage"):FindFirstChild("ClientAssets")
        local skins = clientAssets
            and clientAssets:FindFirstChild("Characters")
            and clientAssets.Characters:FindFirstChild("EXE")
            and clientAssets.Characters.EXE:FindFirstChild("Fleetway")
            and clientAssets.Characters.EXE.Fleetway:FindFirstChild("Skins")
 
